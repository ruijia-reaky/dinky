# Bash .env；含特殊字符的值用单引号包住，@ 不需要转义。不要提交真实 .env。
DINKY_VERSION='1.3.0-SNAPSHOT'
AGENT_VERSION='1.3.0'
FLINK_VERSION='1.18.1'
DINKY_IMAGE="dinky-offline:${DINKY_VERSION}-history"
AGENT_IMAGE="dinky-log-agent:${AGENT_VERSION}"
FLINK_IMAGE='flink-offline:1.18.1-dinky130-run-batches'
DINKY_NAMESPACE='dinky130-offline'
FLINK_NAMESPACE='dinky130-flink'
AGENT_NAMESPACE='dinky-log-agents-offline'
LOG_ROOT='/data/flink-logs'
AGENT_PORT=18090
AGENT_CONTAINER_PORT=18089
LOG_AGENT_TOKEN=''
DINKY_PORT=8888
DINKY_NODE_PORT=30888
MYSQL_HOST=''
MYSQL_PORT=3306
MYSQL_DATABASE='dinky130_new'
MYSQL_USERNAME='dinky'
MYSQL_PASSWORD=''
DINKY_STORAGE_CLASS=''
DINKY_STORAGE_SIZE='5Gi'
DINKY_JAVA_OPTIONS='-Xms256m -Xmx1536m -Duser.timezone=Asia/Shanghai'
DINKY_EXTRA_CLASSPATH='/opt/dinky/lib/log4j-slf4j-impl-2.19.0.jar:/opt/dinky/lib/log4j-api-2.19.0.jar:/opt/dinky/lib/log4j-core-2.19.0.jar:/opt/dinky/lib/okio-2.8.0.jar:/opt/dinky/lib/okhttp-4.9.3.jar:/opt/dinky/lib/dinky-client-1.18-1.3.0-SNAPSHOT.jar'
# Flink 状态存储：建议使用已存在的 RWX PVC。例：flink-state；空值仅用于无恢复承诺的冒烟测试。
FLINK_STATE_PVC='flink-state'
FLINK_PARALLELISM=1
FLINK_HA_ENABLED=true
FLINK_NFS_SERVER=''
FLINK_NFS_PATH=''
FLINK_STATE_SIZE='10Gi'
DINKY_TOKEN_NAME='dinky130-token'
